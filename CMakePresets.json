{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-Ninja",
      "description": "Base Ninja inheritance which all other builds are based on",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "warnings": {
        "dev": false
      }
    },
    {
      "name": "base-Windows-Ninja",
      "description": "Base Window's inheritance which all other Windows builds are based on",
      "inherits": "base-Ninja",
      "hidden": true,
      "cmakeExecutable": "\"C:\\Program Files\\CMake\\bin\\cmake.exe\"",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "MinGW-RelWithDebInfo-x64",
      "displayName": "MinGW-RelWithDebInfo-x64",
      "inherits": "base-Windows-Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW-max"
        }
      }
    },
    {
      "name": "MSVC-RelWithDebInfo-x64",
      "displayName": "MSVC-RelWithDebInfo-x64",
      "inherits": "base-Windows-Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MSVC"
        }
      }
    },
    {
      "name": "wsl-base",
      "displayName": "wsl-base",
      "inherits": "base-Ninja",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SC2_RENDERER": "OFF"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "WSL"
        }
      }
    },
    {
      "name": "wsl-profiler",
      "displayName": "WSL Profiler (RelWithDebInfo)",
      "inherits": "wsl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer"
      }
    },
    {
      "name": "wsl-debug",
      "displayName": "WSL Debug",
      "inherits": "wsl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
