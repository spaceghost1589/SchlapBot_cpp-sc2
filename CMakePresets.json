{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20"
      },
      "name": "base-Ninja",
      "description": "Base Ninja inheritance which all other build are based on",
      "generator": "Ninja",
      "hidden": true,
      "installDir": "${sourceDir}/install/${presetName}",
      "warnings": {
        "dev": false
      }
    },
    {
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cmakeExecutable": "C:/SC2AI/_Resources/_toolchains/CMake/cmake-4.4.3-windows-x86_64/bin/cmake.exe",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "name": "base-Windows-Ninja",
      "inherits": "base-Ninja",
      "description": "Base Window's inheritance which all other Windows builds are based on",
      "hidden": true,
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "name": "MinGW-RelWithDebInfo-x64",
      "displayName": "MinGW-RelWithDebInfo-x64",
      "inherits": "base-Windows-Ninja",
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW-max"
        }
      }
    },
    {
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "name": "MSVC-RelWithDebInfo-x64",
      "displayName": "MSVC-RelWithDebInfo-x64",
      "inherits": "base-Windows-Ninja",
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MSVC"
        }
      }
    },
    {
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "name": "x64-Release",
      "displayName": "Release",
      "inherits": "base-Windows-Ninja"
    },
    {
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "name": "x64-Debug",
      "displayName": "Debug",
      "inherits": "base-Windows-Ninja"
    }
  ]
}
